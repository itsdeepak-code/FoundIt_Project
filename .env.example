# Copy this file to .env (in the project root) and adjust the values.

# Port for the Express API (5000 is taken by AirPlay on macOS)
PORT=5050

# Local MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/foundit

# Secret used to sign login tokens - use a long random string
JWT_SECRET=replace_with_a_long_random_secret

# How long a login lasts
JWT_EXPIRES_IN=7d

# Where the React app runs (used for CORS)
CLIENT_URL=http://localhost:5173

# development | production
NODE_ENV=development
